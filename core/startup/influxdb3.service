[Unit]
Description=Chronoracer InfluxDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
# INFLUX_HTTP_BIND and INFLUX_SNAPSHOT_CONCURRENCY_LIMIT come from start-influx.sh. Localhost only.
EnvironmentFile=/chronoracer/influxdb3.env
# Forced snapshots persist on all but one vCPU, so ingest and Core keep running.
ExecStart=/usr/bin/env influxdb3 serve --node-id core --object-store file --data-dir /var/lib/influxdb3 --http-bind ${INFLUX_HTTP_BIND} --admin-token-file /chronoracer/admin-token.json --wal-flush-interval 100ms --force-snapshot-mem-size 15% --snapshot-concurrency-limit ${INFLUX_SNAPSHOT_CONCURRENCY_LIMIT} --file-cache-size 10% --exec-mem-pool-size 20% --force-snapshot-max-age 10m
# Contain memory pressure to InfluxDB: throttle, then OOM-kill only this unit and restart it (WAL replay).
MemoryHigh=70%
MemoryMax=80%
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
