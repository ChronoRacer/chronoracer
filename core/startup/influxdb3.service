[Unit]
Description=Chronoracer InfluxDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
Environment=VIRTUAL_ENV=/chronoracer/influxdb-plugin-venv
# INFLUX_HTTP_BIND comes from platform.json via start-influx.sh. Localhost only.
EnvironmentFile=/chronoracer/influxdb3.env
ExecStart=/usr/bin/env influxdb3 serve --node-id core --object-store file --data-dir /var/lib/influxdb3 --plugin-dir /chronoracer/influxdb-plugins --http-bind ${INFLUX_HTTP_BIND} --admin-token-file /chronoracer/admin-token.json --disable-package-management --wal-flush-interval 100ms --force-snapshot-mem-size 30% --file-cache-size 10% --exec-mem-pool-size 20% --force-snapshot-max-age 10m
# Contain memory pressure to InfluxDB: throttle, then OOM-kill only this unit and restart it (WAL replay).
MemoryHigh=70%
MemoryMax=80%
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
