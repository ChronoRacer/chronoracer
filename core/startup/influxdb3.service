[Unit]
Description=Chronoracer InfluxDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
Environment=VIRTUAL_ENV=/chronoracer/influxdb-plugin-venv
ExecStart=/usr/bin/env influxdb3 serve --node-id core --object-store file --data-dir /var/lib/influxdb3 --plugin-dir /chronoracer/influxdb-plugins --http-bind 127.0.0.1:8181 --admin-token-file /chronoracer/admin-token.json --disable-package-management
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
