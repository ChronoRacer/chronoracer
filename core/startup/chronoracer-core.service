[Unit]
Description=Chronoracer Core
After=influxdb3.service
Wants=influxdb3.service

[Service]
Type=simple
UMask=0077
WorkingDirectory=/chronoracer
Environment=HOME=/root
EnvironmentFile=/chronoracer/core.env
ExecStart=/chronoracer/core
# Needed for long export sequence
TimeoutStopSec=900
# Keep Core alive under system memory pressure; InfluxDB is the intended OOM victim.
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
