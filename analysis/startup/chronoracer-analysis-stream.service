[Unit]
Description=Chronoracer Analysis stream (Pathway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=/chronoracer
Environment=PYTHONPATH=/chronoracer
Environment=LOGURU_LEVEL=INFO
EnvironmentFile=/chronoracer/analysis.env
ExecStart=/chronoracer/analysis-venv/bin/python -m analysis.data_stream.pathway_stream_pub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
