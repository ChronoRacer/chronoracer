{
  "name": "@chronoracer/telemetry",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "buf generate ../core/proto --template buf.gen.yaml",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "build": "pnpm run generate && pnpm run build:server && pnpm run build:client",
    "start": "node dist/server/index.js",
    "load:charts": "pnpm run build && node scripts/load-charts.mjs",
    "test": "vitest run",
    "dev:server": "pnpm run generate && tsc -p tsconfig.server.json --watch",
    "dev:client": "vite",
    "buf:lint": "buf lint ../core/proto",
    "buf:breaking": "buf breaking ../core/proto --against '.git#branch=master'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.5",
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.3.1",
    "@hono/oidc-auth": "^1.10.0",
    "@platformatic/kafka": "^2.14.0",
    "@t3-oss/env-core": "^0.13.11",
    "denque": "^2.1.0",
    "hono": "^4.9.0",
    "leaflet": "^1.9.4",
    "motion": "^14.1.0",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.2",
    "oauth4webapi": "^3.8.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uplot": "^1.6.32",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.57.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "ts-proto": "^2.12.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
