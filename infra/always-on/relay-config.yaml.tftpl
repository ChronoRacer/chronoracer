server:
  host: 0.0.0.0
  port: 8080
  log_level: info
okta:
  issuer: https://chronoracer.eu.auth0.com/
  audience: https://api.chronoracer.com
gcp:
  enabled: true
  project_id: ${project_id}
  firestore_database: "(default)"
  export_bucket: ${export_bucket}
  cloud_build_trigger_id: ${cloud_build_trigger_id}
  cloud_build_location: ${cloud_build_location}
  build_finished_audience: ${build_finished_audience}
  build_finished_service_account: ${build_finished_service_account}
  export_done_audience: ${export_done_audience}
  export_done_service_account: ${export_done_service_account}
  build_finished_topic: ${cloud_build_topic}
  export_done_topic: ${export_done_topic}
  kafka_private_bootstrap: ${kafka_private_bootstrap}
  kafka_control_topic: ${kafka_control_topic}
  kafka_heartbeat_topic: ${kafka_heartbeat_topic}
  kafka_event_topic: ${kafka_event_topic}
  kafka_public_port: ${kafka_public_port}
service:
  heartbeat_freshness_seconds: 50
  build_bind_window_seconds: 600
